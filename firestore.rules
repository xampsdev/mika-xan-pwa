rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validates exclusive administrator account (Xan)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'xampsbeatz@gmail.com';
    }

    // 1. Tutors Collection (Fields 1-3)
    // Public read, create, update to allow client phone lookup and returning client registration.
    // Delete restricted strictly to authenticated admins.
    match /tutors/{tutorId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 2. Pets Collection (Fields 4-22)
    // Public read, create, update so clients can load existing profiles and update routine data.
    // Delete restricted strictly to authenticated admins.
    match /pets/{petId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // 3. Stays Collection (Check-in History)
    // Clients can create new stays if status is 'pending'.
    // Read, update (check-in/check-out completion), and delete restricted strictly to admins.
    match /stays/{stayId} {
      allow create: if (request.resource.data.status == 'pending') || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // 4. Admin Push Tokens Collection
    // Read and write operations restricted strictly to authorized admins.
    match /admin_tokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    // Default Fallback: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
